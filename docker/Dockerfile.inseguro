# ==============================================================================
# Dockerfile.inseguro - Alvo de Auditoria e Testes de Bloqueio (Policy as Code)
# Contem violacoes propositais para validacao das regras Rego v1 (Trilhas 1 e 2)
# ==============================================================================

# VIOLACAO 1: Tag mutavel :latest em vez de versao fixada ou digest SHA-256
FROM node:latest

WORKDIR /app

# VIOLACAO 2: Instalacao sem travas e copia irrestrita
COPY src/ ./
RUN npm install

# VIOLACAO 3: Execucao como usuario privilegiado (root)
USER root

EXPOSE 3000
CMD ["node", "app.js"]

